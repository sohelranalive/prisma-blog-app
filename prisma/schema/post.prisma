model Posts {
    id         String     @id @default(uuid())
    title      String     @db.VarChar(255)
    content    String     @db.Text
    thumbnail  String?
    isFeatured Boolean    @default(false)
    status     PostStatus @default(PUBLISHED)
    tags       String[]
    views      Int        @default(0)
    authorId   String
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    comments   Comments[]

    @@index([authorId])
}

enum PostStatus {
    DRAFT
    PUBLISHED
    UNPUBLISHED
    ARCHIVE
}
